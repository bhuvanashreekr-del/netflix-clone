# Django Core Configuration
SECRET_KEY=django-insecure-change-this-in-production-streamflix-2026
DEBUG=False
ALLOWED_HOSTS=*

# MongoDB Cloud / Atlas Configuration (for Chat Logs & Feedback)
# Leave blank to automatically use the resilient local document fallback store
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=streamflix_db

# Google Gemini LLM API Key (Optional - Falls back to Built-in Cinematic NLP Engine)
GEMINI_API_KEY=your-google-gemini-api-key-here
